# Copy to .env in this directory (gitignored). Required for integration tests that call OpenAI.
OPENAI_API_KEY=

# Optional: fixed deck stream seed for reproducible card order (CLI default is random if unset).
# BLACKJACK_DECK_SEED=42

# Optional: LangGraph SQLite checkpoint file (default: data/checkpoints.sqlite under repo root).
# Must be a file path (not :memory:). Tests set this to a temp file via tests/conftest.py.
# BLACKJACK_CHECKPOINT_DB=/absolute/path/checkpoints.sqlite
